--cpu Cortex-M3
"tanjimdis\startup_stm32f103xb.o"
"tanjimdis\main.o"
"tanjimdis\stm32f1xx_it.o"
"tanjimdis\stm32f1xx_hal_msp.o"
"tanjimdis\fonts.o"
"tanjimdis\ssd1306.o"
"tanjimdis\stm32f1xx_hal_gpio_ex.o"
"tanjimdis\stm32f1xx_hal_i2c.o"
"tanjimdis\stm32f1xx_hal.o"
"tanjimdis\stm32f1xx_hal_rcc.o"
"tanjimdis\stm32f1xx_hal_rcc_ex.o"
"tanjimdis\stm32f1xx_hal_gpio.o"
"tanjimdis\stm32f1xx_hal_dma.o"
"tanjimdis\stm32f1xx_hal_cortex.o"
"tanjimdis\stm32f1xx_hal_pwr.o"
"tanjimdis\stm32f1xx_hal_flash.o"
"tanjimdis\stm32f1xx_hal_flash_ex.o"
"tanjimdis\stm32f1xx_hal_exti.o"
"tanjimdis\system_stm32f1xx.o"
--strict --scatter "TanjimDIS\TanjimDIS.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "TanjimDIS.map" -o TanjimDIS\TanjimDIS.axf